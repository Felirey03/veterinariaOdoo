<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.veterinaria</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Veterinaria" name="veterinaria">
                    <block title="Configuración de Inteligencia Artificial" name="ai_config">
                        <setting string="Groq API" help="Configura la conexión con la IA de Groq">
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="groq_api_key" string="API Key"/>
                                    <field name="groq_api_key" password="True"/>
                                </div>
                                <div class="text-muted">
                                    Obténgala en <a href="https://console.groq.com/keys" target="_blank">Groq Console</a>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_veterinaria_config" model="ir.actions.act_window">
        <field name="name">Configuración Veterinaria</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'veterinaria'}</field>
    </record>

    <menuitem id="menu_veterinaria_config" 
              name="Configuración" 
              parent="veterinaria_menu" 
              sequence="100" 
              action="action_veterinaria_config"/>
</odoo>
